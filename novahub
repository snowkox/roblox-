function Segmented(parent, o)
	o = o or {}
	local items = o.items or {}
	local f = Create("Frame", {
		Size = o.size or UDim2.new(1, -24, 0, o.h or 34),
		Position = o.pos or UDim2.fromOffset(12, 8),
		BackgroundColor3 = Theme.v.bg3,
		BorderSizePixel = 0,
		LayoutOrder = o.order or 0,
		Visible = o.visible ~= false,
	}, parent)
	Round(f, 10)
	ListLayout(f, 4, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	local selected = o.selected or 1
	local entries = {}
	for i, item in ipairs(items) do
		local label = type(item) == "table" and (item.label or item.value) or item
		local value = type(item) == "table" and item.value or item
		local ctl = Button(f, {
			size = UDim2.new(1, -8, 1, -6),
			variant = "ghost",
			radius = 8,
			text = label,
			align = "center",
			textPad = 6,
			fontSize = o.fontSize or 12,
			order = i,
		})
		entries[i] = { ctl = ctl, value = value }
	end

	local function repaint()
		for i, e in ipairs(entries) do
			local active = (i == selected)
			e.ctl.Frame.BackgroundColor3 = active and Theme.v.accent or Theme.v.bg
			e.ctl.Label.TextColor3 = active and Theme.v.onAccent or Theme.v.dim
		end
	end
	Watch(f, repaint)
	repaint()

	for i, e in ipairs(entries) do
		e.ctl.Click(function()
			if selected == i then return end
			selected = i
			repaint()
			if o.onChange then o.onChange(e.value, i) end
		end)
	end

	local C = { Frame = f }
	function C.Select(i, silent)
		selected = i
		repaint()
		if not silent and o.onChange then o.onChange(entries[i] and entries[i].value or nil, i) end
	end
	function C.Selected() return selected end
	function C.SetItems(newItems)
		items = newItems
	end
	return C
end

