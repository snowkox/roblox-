function Providers.all() return CONFIG.providers end

function Providers.get(id)
	for _, p in ipairs(CONFIG.providers) do if p.id == id then return p end end
	return nil
end

function Providers.new(data)
	local p = {
		id = U.uid(),
		name = data.name or "Novo provider",
		url = data.url or "",
		key = data.key or "",
		kind = data.kind or "openai",
		models = data.models or {},
		class = data.class or {},
		allFree = data.allFree == true,
		status = "untested",
		err = "",
		checked = 0,
		modelCount = 0,
		created = os.time(),
	}
	CONFIG.providers[#CONFIG.providers + 1] = p
	CONFIG.selected[p.id] = CONFIG.selected[p.id] or {}
	return p
end

function Providers.remove(id)
	for i, p in ipairs(CONFIG.providers) do
		if p.id == id then table.remove(CONFIG.providers, i) break end
	end
	CONFIG.selected[id] = nil
	if CONFIG.active and CONFIG.active.provider == id then CONFIG.active = nil end
	if Nova.Window and Nova.Window.refreshTitle then Nova.Window.refreshTitle() end
	Config.save()
end

function Providers.selectedMap(p)
	if not p or not p.id then return {} end
	CONFIG.selected[p.id] = CONFIG.selected[p.id] or {}
	return CONFIG.selected[p.id]
end

function Providers.selectedModels(p)
	local map = Providers.selectedMap(p)
	local list = {}
	for id, on in pairs(map) do if on then list[#list + 1] = id end end
	table.sort(list)
	return list
end

function Providers.models(p)
	if p.models and #p.models > 0 then return p.models end
	return {}
end

function Providers.select(p, model, on)
	local map = Providers.selectedMap(p)
	map[model] = on ~= false
	Config.save()
end

function Providers.selectAll(p, on, onlyFree)
	local map = Providers.selectedMap(p)
	for _, m in ipairs(Providers.models(p)) do
		if not onlyFree or Providers.classify(p, m) == onlyFree then
			map[m] = on ~= false
		end
	end
	Config.save()
end

function Providers.clearAll(p)
	local map = Providers.selectedMap(p)
	for k in pairs(map) do map[k] = nil end
	Config.save()
end

function Providers.active()
	if CONFIG.active and CONFIG.active.model then
		local p = Providers.get(CONFIG.active.provider)
		if p then return p, CONFIG.active.model end
	end
	-- primeiro provider com modelo selecionado
	for _, p in ipairs(CONFIG.providers) do
		local sel = Providers.selectedModels(p)
		if #sel > 0 then return p, sel[1] end
	end
	return nil, nil
end

function Providers.setActive(providerId, model)
	CONFIG.active = { provider = providerId, model = model }
	if Nova.Window and Nova.Window.refreshTitle then Nova.Window.refreshTitle() end
	Config.save()
end

function Providers.hasProviders() return #CONFIG.providers > 0 end

function Providers.ready()
	local p, m = Providers.active()
	return (p ~= nil and m ~= nil), p, m
end

