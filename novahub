function Engine.treeText(pathOrInst, depth)
	depth = depth or 3
	local root = pathOrInst
	if type(pathOrInst) == "string" then
		local ok, res = pcall(function()
			if pathOrInst == "" or pathOrInst == "game" then return game end
			if pathOrInst:sub(1, 5) == "game." then
				return game:GetService(pathOrInst:sub(6))
			end
			return game:GetService(pathOrInst)
		end)
		if not ok or not res then return "caminho invÃ¡lido: " .. tostring(pathOrInst) end
		root = res
	end
	if type(root) ~= "Instance" then return "alvo invÃ¡lido" end
	local out = {}
	local function walk(inst, d, prefix)
		local kids = inst:GetChildren()
		local n = #kids
		for i, child in ipairs(kids) do
			if d <= depth then
				out[#out + 1] = prefix .. (i < n and "â”œâ”€ " or "â””â”€ ") .. child.Name .. "  [" .. child.ClassName .. "]"
				walk(child, d + 1, prefix .. (i < n and "â”‚  " or "   "))
			end
		end
	end
	out[#out + 1] = root:GetFullName() .. "  [" .. root.ClassName .. "]"
	walk(root, 1, "")
	if #out == 1 then return out[1] .. "\n(sem filhos)" end
	return table.concat(out, "\n")
end

