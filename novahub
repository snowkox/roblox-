	M.Panel = panel
	M.Body = body
	M.Footer = footer
	M.Depth = depth
	M.CanClose = o.canClose ~= false
	M.Z = z
	function M.Close()
		if closed then return end
		closed = true
		for i = #modalStack, 1, -1 do
			if modalStack[i] == M then table.remove(modalStack, i) break end
		end
		if o.onClose then pcall(o.onClose) end
		Compat.tween(overlay, 0.14, { BackgroundTransparency = 1 })
		local t2 = Compat.tween(panel, 0.14, { BackgroundTransparency = 1, Size = UDim2.fromOffset(w * 0.94, h * 0.94) })
		t2.Completed:Connect(function() overlay:Destroy() end)
	end
	function M.SetTitle(t2) if M.titleLabel then M.titleLabel.Text = t2 end end
	overlay.InputBegan:Connect(function(i)
		if o.closeOnClick == false then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 and i.Target == overlay then M.Close() end
	end)
	modalStack[#modalStack + 1] = M
	return M
end

