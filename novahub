Toast = function(msg, kind, dur)
	kind = kind or "info"
	if not toastHost then
		toastHost = Create("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 300,
		}, Compat.guiHost)
		ListLayout(toastHost, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)
		Pad(toastHost, 0, 0, 0, 120)
	end
	local roles = { info = "accent", ok = "ok", err = "danger", warn = "warn" }
	local icons = { info = "info", ok = "checkCircle", err = "xCircle", warn = "warn" }
	local f = Create("Frame", {
		BackgroundColor3 = Theme.v.bg2,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(340, 44),
		BackgroundTransparency = 1,
		ZIndex = 305,
		LayoutOrder = (os.time() or 0) + math.random(1, 500),
	}, toastHost)
	Round(f, 12)
	local st = Stroke(f, Theme.v.border, 1)
	Watch(f, function() f.BackgroundColor3 = Theme.v.bg2 end)
	Watch(st, function() st.Color = Theme.v.bg4 end)
	local bar = Create("Frame", {
		Size = UDim2.fromOffset(3, 20),
		BackgroundColor3 = Theme.v.accent,
		Position = UDim2.fromOffset(11, 12),
		BorderSizePixel = 0,
	}, f)
	Round(bar, 2)
	local ic = MakeIcon(nil, icons[kind] or "info", 16, Theme.v.accent)
	ic.Position = UDim2.fromOffset(24, 14)
	ic.Parent = f
	local msgStr = tostring(msg)
	local l = Text(f, {
		text = msgStr, size = 13, dim = UDim2.new(1, -68, 1, 0),
		pos = UDim2.fromOffset(50, 0), TextWrapped = true, alignY = Enum.TextYAlignment.Center,
	})
	f.Size = UDim2.fromOffset(math.clamp(150, 420, 60 + #msgStr * 6.6), 44)

	local function setColor()
		local c = Theme.v[roles[kind] or "accent"]
		paintIcon(ic, c)
		bar.BackgroundColor3 = c
	end
	Watch(f, setColor)
	setColor()

	Compat.tween(f, 0.22, { BackgroundTransparency = 0 })
	task.delay(dur or 3.4, function()
		if f.Parent then
			local t = Compat.tween(f, 0.25, { BackgroundTransparency = 1 })
			t.Completed:Connect(function() if f.Parent then f:Destroy() end end)
		end
	end)
	return f
end

