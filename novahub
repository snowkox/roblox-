local function findFences(text)
	local list = {}
	local pos = 1
	while true do
		local s, e, lang = text:find("```([%w_%-+#]*)", pos)
		if not s then break end
		local lineEnd = text:find("\n", e, true)
		local bodyStart = (lineEnd or (#text + 1))
		local closeS = text:find("```", bodyStart, true)
		if not closeS then
			list[#list + 1] = {
				sStart = s, sStop = #text, lang = lang,
				body = text:sub(bodyStart + 1):gsub("%s+$", ""),
			}
			break
		end
		list[#list + 1] = {
			sStart = s, sStop = closeS + 2, lang = lang,
			body = (text:sub(bodyStart + 1, closeS - 1):gsub("%r", "")),
		}
		pos = closeS + 3
	end
	return list
end

-- retorna segmentos ordenados: {type="text"|"code"}
function AI.parse(text)
	text = tostring(text or "")
	local fences = findFences(text)

	local markers = {}
	local pos = 1
	while true do
		local s, e, kind = text:find("%[%[NOVA_(RUN|SCRIPT)%]%]", pos)
		if not s then break end
		markers[#markers + 1] = { s = s, e = e, kind = (kind == "RUN") and "run" or "script" }
		pos = e + 1
	end

	local claimed = {}
	local blocksByMarker = {}
	for i, m in ipairs(markers) do
		local fenceIdx
		for j, f in ipairs(fences) do
			if f.sStart > m.e and not claimed[j] then fenceIdx = j break end
		end
		if fenceIdx then
			claimed[fenceIdx] = true
			blocksByMarker[i] = {
				kind = m.kind,
				code = fences[fenceIdx].body,
				from = m.s,
				to = fences[fenceIdx].sStop,
			}
		else
			local nxt = text:find("%[%[NOVA_[%a]+%]%]", m.e + 1)
			local lim = nxt or (#text + 1)
			blocksByMarker[i] = {
				kind = m.kind,
				code = U.trim(text:sub(m.e + 1, lim - 1)),
				from = m.s,
				to = lim - 1,
			}
		end
	end

	local segments = {}
	local cursor = 1
	for i = 1, #markers do
		local blk = blocksByMarker[i]
		local t = U.trim(text:sub(cursor, blk.from - 1))
		if t ~= "" then segments[#segments + 1] = { type = "text", text = t } end
		if U.trim(blk.code) ~= "" then
			segments[#segments + 1] = { type = "code", kind = blk.kind, code = blk.code }
		end
		cursor = blk.to + 1
	end
	local last = U.trim(text:sub(cursor))
	if last ~= "" then segments[#segments + 1] = { type = "text", text = last } end

	if #segments == 0 then
		segments[1] = { type = "text", text = U.trim(text) }
	end
	return segments
end

