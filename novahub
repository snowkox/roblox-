local U = {}
U.pi = math.pi
U.utf8 = utf8

function U.clamp(v, a, b)
	if v < a then return a end
	if v > b then return b end
	return v
end

function U.round(v)
	return math.floor(v + 0.5)
end

function U.uid()
	return tostring(os.clock()) .. "-" .. tostring(math.random(1, 1e9)) .. "-" .. tostring(U.round((os.time() or 0) * 1000) % 100000)
end

function U.trim(s)
	if type(s) ~= "string" then return "" end
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

function U.short(s, n)
	s = tostring(s or "")
	n = n or 40
	if #s <= n then return s end
	return s:sub(1, n - 1) .. "â€¦"
end

-- escapa texto para RichText
function U.esc(s)
	s = tostring(s or "")
	s = s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	return s
end

-- texto com quebras, seguro para RichText
function U.escLines(s)
	return U.esc(s)
end

function U.lines(s)
	local out = {}
	for l in string.gmatch(tostring(s or "") .. "\n", "(.-)\r?\n") do out[#out + 1] = l end
	return out
end

function U.fromHex(hex)
	hex = string.gsub(tostring(hex or ""), "#", "")
	if #hex == 3 then hex = hex:sub(1, 1) .. hex:sub(1, 1) .. hex:sub(2, 2) .. hex:sub(2, 2) .. hex:sub(3, 3) .. hex:sub(3, 3) end
	local n = tonumber(hex, 16)
	if not n then return Color3.fromRGB(124, 92, 255) end
	return Color3.fromRGB(n >> 16 & 255, n >> 8 & 255, n & 255)
end

function U.toHex(c)
	return string.format("#%02X%02X%02X", math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255))
end

function U.lum(c)
	return 0.2126 * c.R + 0.7152 * c.G + 0.0722 * c.B
end

function U.date(ts)
	ts = ts or os.time()
	local d = os.date("*t", ts)
	return string.format("%02d/%02d %02d:%02d", d.day, d.month, d.hour, d.min)
end

function U.age(ts)
	local d = (os.time() or 0) - (ts or os.time())
	if d < 60 then return "agora" end
	if d < 3600 then return math.floor(d / 60) .. "min" end
	if d < 86400 then return math.floor(d / 3600) .. "h" end
	return math.floor(d / 86400) .. "d"
end

function U.copy(t)
	if type(t) ~= "table" then return t end
	local out = {}
	for i, v in ipairs(t) do out[i] = U.copy(v) end
	for k, v in pairs(t) do if not (type(k) == "number") then out[k] = U.copy(v) end end
	return out
end

function U.count(t)
	local n = 0
	for _ in pairs(t or {}) do n = n + 1 end
	return n
end

function U.contains(list, v)
	for _, x in ipairs(list or {}) do if x == v then return true end end
	return false
end

function U.titleCase(s)
	return (tostring(s or ""):gsub("(%a)([%w']*)", function(a, b) return a:upper() .. b:lower() end))
end

