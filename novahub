-- normaliza respostas diferentes entre executores
local function normalize(res)
	if res == nil then return false, "sem resposta", 0, {} end
	if type(res) == "string" then return true, res, 200, {} end
	if type(res) ~= "table" then return false, tostring(res), 0, {} end

	local body = res.Body or res.body or res.Content or res.content or res.Data or res.data
	local code = res.StatusCode or res.status_code or res.Status or res.status or res.Code or res.code
	local headers = res.Headers or res.headers or {}
	local success = res.Success or res.success

	if type(code) == "string" then code = tonumber(code) end
	local okBool
	if type(code) == "number" then
		okBool = code >= 200 and code < 300
	elseif success ~= nil then
		okBool = success and true or false
	else
		okBool = true
	end
	return okBool, tostring(body or ""), tonumber(code) or 0, headers
end

-- requisiÃ§Ã£o HTTP principal: Compat.http({Url=, Method=, Headers=, Body=, Timeout=})
function Compat.http(o)
	o = o or {}
	local url    = o.Url or o.url
	local method = string.upper(o.Method or o.method or "GET")
	local headers = o.Headers or o.headers or {}
	local body   = o.Body or o.body

	if HTTP_FN then
		local okCall, res = pcall(HTTP_FN, {
			Url     = url,
			Method  = method,
			Headers = headers,
			Body    = body,
		})
		if not okCall then return false, tostring(res), 0, {} end
		return normalize(res)
	end

	-- fallback: HttpService (funciona melhor em GET)
	local okCall, res = pcall(function()
		return HttpService:RequestAsync({ Url = url, Method = method, Headers = headers, Body = body })
	end)
	if not okCall then return false, tostring(res), 0, {} end
	return normalize(res)
end

function Compat.get(url, headers)
	return Compat.http({ Url = url, Method = "GET", Headers = headers })
end

