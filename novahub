function AI.respond(chat, h)
	h = h or {}
	local provider, model = Providers.active()
	if not provider then
		if h.onError then h.onError("nenhum modelo selecionado") end
		return
	end
	local maxSteps = math.max(1, CONFIG.ai.maxSteps or 4)
	local step = 0

	while true do
		step = step + 1
		if h.onStatus then h.onStatus(step > 1 and ("executando Â· passo " .. step) or "pensando...") end

		local text, err = AI.raw(provider, model, AI.messagesFor(chat, step))
		if not text then
			if h.onDone then h.onDone(err) end
			return
		end

		local segments = AI.parse(text)
		chat.api[#chat.api + 1] = { role = "assistant", content = text }
		if h.onAssistant then h.onAssistant(segments) end

		local autoExec = CONFIG.ai.autoExec ~= false
		local runs = {}
		for _, s in ipairs(segments) do
			if s.type == "code" and s.kind == "run" then runs[#runs + 1] = s end
		end

		if not autoExec or #runs == 0 or step >= maxSteps then
			if #runs > 0 and not autoExec and h.onNotice then
				h.onNotice("ExecuÃ§Ã£o automÃ¡tica desligada: use o botÃ£o â–¶ no bloco de cÃ³digo.")
			end
			if h.onDone then h.onDone(nil) end
			return
		end

		local outputs = {}
		for i, seg in ipairs(runs) do
			if h.onRunStart then h.onRunStart(seg) end
			local res = Engine.exec(seg.code, {
				onLog = function(l)
					if h.onRunLog then h.onRunLog(seg, l) end
				end,
			})
			if h.onRunEnd then h.onRunEnd(seg, res) end
			local bodyText
			if res.ok then
				local logs = table.concat(res.logs, "\n")
				bodyText = (#logs > 0) and logs or "(executado sem erro e sem print)"
			else
				bodyText = "ERRO: " .. tostring(res.err)
			end
			outputs[#outputs + 1] = ("execuÃ§Ã£o %d:\n%s"):format(i, U.short(bodyText, 1500))
		end

		chat.api[#chat.api + 1] = {
			role = "user",
			content = "âŸ¦saÃ­da da execuÃ§Ã£o no clienteâŸ§\n" .. table.concat(outputs, "\n\n"),
		}
	end
end

