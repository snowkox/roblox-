function Chat.rebuild()
	local ui = Chat.ui
	if not ui.bubbleHost then return end
	for _, c in ipairs(ui.bubbleHost:GetChildren()) do c:Destroy() end
	local chat = Chat.current
	if not chat or #chat.messages == 0 then
		Chat.renderEmpty()
		return
	end
	for _, msg in ipairs(chat.messages) do
		local row, bubble, inner = makeBubble(ui.bubbleHost, msg.role)
		msg.refs = renderSegments(msg, inner)
	end
	task.defer(function() scrollToEnd(ui.scroll, true) end)
end

