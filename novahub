function Text(parent, o)
	o = o or {}
	local l = Create("TextLabel", {
		BackgroundTransparency = 1,
		Text = o.text or "",
		TextSize = o.size or 14,
		Font = o.font or FONT,
		TextColor3 = o.color or Theme.v.text,
		TextXAlignment = o.alignX or Enum.TextXAlignment.Left,
		TextYAlignment = o.alignY or Enum.TextYAlignment.Center,
		TextTruncate = o.truncate or Enum.TextTruncate.None,
		TextWrapped = o.wrapped or false,
		RichText = o.rich or false,
		Size = o.dim or UDim2.fromOffset(120, 20),
		Position = o.pos or UDim2.fromOffset(0, 0),
		AnchorPoint = o.anchor,
		Rotation = o.rot,
		ZIndex = o.z,
		LayoutOrder = o.order or 0,
		Visible = o.visible ~= false,
	}, parent)
	if o.role then
		local role = o.role
		Watch(l, function() l.TextColor3 = Theme.v[role] or Theme.v.text end)
	end
	if o.onClick then
		l.Active = true
		l.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then o.onClick() end
		end)
	end
	return l
end

-- ARRASTAR (declarado antes de ser usado) ------------------------------------
function Dragify(handle, onMove, onStart, onEnd)
	local dragging = false
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton2 then
			dragging = true
			local x, y = UIS:GetMouseLocation()
			if onMove then onMove(x, y, true) end
			if onStart then onStart() end
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if not dragging then return end
		if i.UserInputType == Enum.UserInputType.MouseMovement
			or i.UserInputType == Enum.UserInputType.Touch then
			local x, y = UIS:GetMouseLocation()
			if onMove then onMove(x, y, false) end
		end
	end)
	UIS.InputEnd:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1
			or i.UserInputType == Enum.UserInputType.Touch
			or i.UserInputType == Enum.UserInputType.MouseButton2) then
			dragging = false
			if onEnd then onEnd() end
		end
	end)
	return function() dragging = false end
end

