-- garante que existe um modelo ativo
function Providers.ensureActive()
	if CONFIG.active and CONFIG.active.model then
		local p = Providers.get(CONFIG.active.provider)
		if p then
			local map = Providers.selectedMap(p)
			if map[CONFIG.active.model] == nil then
				local sel = Providers.selectedModels(p)
				if #sel > 0 then CONFIG.active.model = sel[1] end
			end
			return
		end
	end
	for _, p in ipairs(CONFIG.providers) do
		local sel = Providers.selectedModels(p)
		if #sel > 0 then
			CONFIG.active = { provider = p.id, model = sel[1] }
			return
		end
	end
	CONFIG.active = nil
end

-- itens para o seletor de modelo do chat
function Providers.pickerItems()
	local items = {}
	for _, p in ipairs(CONFIG.providers) do
		local sel = Providers.selectedModels(p)
		if #sel > 0 then
			for _, m in ipairs(sel) do
				items[#items + 1] = {
					label = U.short(m, 40) .. "   Â·   " .. U.short(p.name, 16),
					value = p.id .. "|" .. m,
				}
			end
		end
	end
	if #items == 0 then
		items[#items + 1] = { label = "Nenhum modelo selecionado", value = "" }
	end
	return items
end


