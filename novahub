function Chat.send(preset)
	local ui = Chat.ui
	if Chat.busy then return end
	local text = U.trim(preset or (ui and ui.input and ui.input.Get() or ""))
	if text == "" then return end

	if not Providers.hasProviders() then
		Toast("Adicione um provider em ConfiguraÃ§Ãµes primeiro", "warn", 4)
		Nova.Settings.open("providers")
		return
	end
	local okReady, provider, model = Providers.ready()
	if not okReady then
		Toast("Selecione um modelo para conversar", "warn", 4)
		Chat.openModelPicker()
		return
	end

	local chat = Chat.current
	if not chat then chat = Chat.new(nil, true) end
	Chat.ensureApi(chat)

	if ui.input then ui.input.Clear() end

	local userMsg = { role = "user", text = text, segments = { { type = "text", text = text } } }
	chat.api[#chat.api + 1] = { role = "user", content = text }
	Chat.appendMessage(userMsg)

	Chat.busy = true
	Chat.cancelled = false
	Chat.setStatus("pensando")
	if ui.stopBtn then ui.stopBtn.SetVisible(true) end
	if ui.sendBtn then ui.sendBtn.SetVisible(false) end

	local assistantMsg = { role = "assistant", segments = {} }
	chat.messages[#chat.messages + 1] = assistantMsg
	local row, bubble, inner, meta = makeBubble(Chat.ui.bubbleHost, "assistant")
	assistantMsg.refs = renderSegments(assistantMsg, inner)

	task.spawn(function()
	AI.respond(chat, {
		onStatus = function(s)
			Chat.setStatus(s)
		end,
		isCancelled = function() return Chat.cancelled end,
		onAssistant = function(segments)
			if Chat.cancelled then return end
			for _, seg in ipairs(segments) do
				assistantMsg.segments[#assistantMsg.segments + 1] = seg
				if seg.type == "text" then
					local holder = Create("Frame", {
						Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1, LayoutOrder = nextOrder(),
					}, inner)
					local l = Text(holder, {
						text = "", size = 14, dim = UDim2.new(1, 0, 0, 18),
						TextWrapped = true, alignY = Enum.TextYAlignment.Top, rich = true, role = "dim",
					})
					l.AutomaticSize = Enum.AutomaticSize.Y
					local rich = mdToRich(seg.text)
					if isAtEnd(Chat.ui.scroll) then
						task.spawn(typewriter, l, rich, 0.0012)
					else
						l.Text = rich
					end
				else
					local cc = makeCodeCard(inner, seg)
					cc.Frame.LayoutOrder = nextOrder()
					seg.card = cc
					if Chat.ui.scroll then scrollToEnd(Chat.ui.scroll, true) end
				end
			end
			chat.updated = os.time()
			Config.save()
			Chat.refreshSidebar()
		end,
		onRunStart = function(seg)
			if seg.card then
				seg.card.SetState("running")
				seg.card.Logs = {}
				seg.card.Out.Text = "executandoâ€¦"
				seg.card.OutWrap.Visible = true
			end
			if Chat.ui.scroll then scrollToEnd(Chat.ui.scroll, true) end
		end,
		onRunLog = function(seg, line)
			if seg.card then
				seg.card.Log(line)
				if Chat.ui.scroll then scrollToEnd(Chat.ui.scroll, true) end
			end
		end,
		onRunEnd = function(seg, res)
			if seg.card then
				seg.card.SetState(res.ok and "done" or "error")
				seg.card.Log(res.ok and "â€” concluÃ­do â€”" or ("â€” erro: " .. tostring(res.err)))
			end
		end,
		onNotice = function(msg) Toast(msg, "info", 4) end,
		onError = function(err)
			Toast(U.short(err, 120), "err", 5)
		end,
		onDone = function(err)
			Chat.busy = false
			Chat.setStatus(nil)
			if Chat.ui.stopBtn then Chat.ui.stopBtn.SetVisible(false) end
			if Chat.ui.sendBtn then Chat.ui.sendBtn.SetVisible(true) end
			if err then
				local l = Text(inner, {
					text = "erro: " .. err, size = 12.5, TextWrapped = true,
					alignY = Enum.TextYAlignment.Top, role = "danger",
					dim = UDim2.new(1, 0, 0, 18),
				})
				l.AutomaticSize = Enum.AutomaticSize.Y
			end
			if Chat.ui.scroll then scrollToEnd(Chat.ui.scroll, true) end
			Config.save()
		end,
	})
	end)
end

function Chat.abort()
	if not Chat.busy then return end
	Chat.cancelled = true
	Chat.busy = false
	Chat.setStatus(nil)
	local ui = Chat.ui
	if ui then
		if ui.stopBtn then ui.stopBtn.SetVisible(false) end
		if ui.sendBtn then ui.sendBtn.SetVisible(true) end
	end
	Toast("Interrompido", "warn", 2)
end

