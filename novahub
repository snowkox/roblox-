Chat.cancelled = false

local function mdToRich(text)
	local t = U.esc(text)
	t = t:gsub("`([^`\n]+)`", "<font face=\"Code\">%1</font>")
	t = t:gsub("%*%*([^*]+)%*%*", "<b>%1</b>")
	t = t:gsub("__(.-)__", "<b>%1</b>")
	return t
end

local function titleFrom(text)
	local t = U.trim(text or "")
	t = t:gsub("\n", " ")
	return #t > 42 and (t:sub(1, 42) .. "â€¦") or (t ~= "" and t or "Nova conversa")
end

function Chat.new(title, quiet)
	local c = {
		id = U.uid(),
		title = title or "Nova conversa",
		created = os.time(),
		updated = os.time(),
		messages = {},
		api = {},
	}
	CONFIG.chats[#CONFIG.chats + 1] = c
	Chat.current = c
	Providers.ensureActive()
	Config.save()
	if not quiet then
		Chat.refreshSidebar()
		Chat.showChatView()
	end
	return c
end

function Chat.get(id)
	for _, c in ipairs(CONFIG.chats) do if c.id == id then return c end end
	return nil
end

-- reconstrÃ³i o histÃ³rico enviado Ã  API a partir das mensagens salvas
function Chat.ensureApi(chat)
	if not chat then return end
	chat.api = chat.api or {}
	if #chat.api > 0 then return end
	for _, m in ipairs(chat.messages or {}) do
		local text
		for _, s in ipairs(m.segments or {}) do
			if s.type == "text" then
				text = (text or "") .. s.text
			elseif s.type == "code" then
				text = (text or "") .. "\n[[NOVA_" .. (s.kind == "run" and "RUN" or "SCRIPT") .. "]]\n```lua\n"
					.. s.code .. "\n```\n[[NOVA_END]]\n"
			end
		end
		if text and U.trim(text) ~= "" then
			chat.api[#chat.api + 1] = { role = m.role, content = text }
		end
	end
end

function Chat.delete(id)
	for i, c in ipairs(CONFIG.chats) do
		if c.id == id then table.remove(CONFIG.chats, i) break end
	end
	if Chat.current and Chat.current.id == id then Chat.new(nil, true) end
	Config.save()
	Chat.refreshSidebar()
	Chat.renderHistory()
end

function Chat.clearAll()
	CONFIG.chats = {}
	Chat.current = nil
	Chat.new(nil, true)
	Config.save()
	Chat.refreshSidebar()
	Chat.renderHistory()
end

local function sortedChats()
	local list = U.copy(CONFIG.chats)
	table.sort(list, function(a, b) return (a.updated or 0) > (b.updated or 0) end)
	return list
end

