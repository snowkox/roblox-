-- varre o jogo procurando remotes
function Engine.scanRemotes(opts)
	opts = opts or {}
	local out = {}
	local visited = 0
	local roots = {}
	local function addRoot(inst)
		if not inst then return end
		if opts.onlyReplicated then
			if inst.Name == "ReplicatedStorage" or inst.Name == "ServerScriptService" then
				roots[#roots + 1] = inst
			end
		else
			roots[#roots + 1] = inst
		end
	end
	addRoot(game:GetService("ReplicatedStorage"))
	addRoot(game:GetService("ServerScriptService"))
	if not opts.onlyReplicated then
		addRoot(game:GetService("Players"))
		addRoot(workspace)
		addRoot(game:GetService("StarterPack"))
	end

	local function walk(inst, depth, path)
		visited = visited + 1
		if visited % 1500 == 0 then task.wait() end
		if depth > (opts.maxDepth or 12) then return end
		for _, child in ipairs(inst:GetChildren()) do
			local isRemote = child:IsA("RemoteEvent") or child:IsA("RemoteFunction")
			local isBindable = child:IsA("BindableEvent")
			if isRemote or (isBindable and opts.includeBindables) then
				out[#out + 1] = {
					path = path .. child.Name,
					name = child.Name,
					class = child.ClassName,
					remote = isRemote,
					instance = child,
				}
			else
				walk(child, depth + 1, path .. child.Name .. ".")
			end
		end
	end

	for _, r in ipairs(roots) do walk(r, 0, r.Name .. ".") end
	return out
end

