local segOrder = 0
local function nextOrder()
	segOrder = segOrder + 1
	return segOrder
end

local function renderSegments(msg, parent)
	local refs = { texts = {}, codes = {} }
	for _, seg in ipairs(msg.segments or {}) do
		if seg.type == "text" then
			local l = Text(parent, {
				text = "", size = 14, dim = UDim2.new(1, 0, 0, 18), order = nextOrder(),
				TextWrapped = true, alignY = Enum.TextYAlignment.Top, rich = true,
				role = msg.role == "user" and "text" or "dim",
			})
			l.AutomaticSize = Enum.AutomaticSize.Y
			if msg.role == "user" then l.TextColor3 = Theme.v.onAccent end
			refs.texts[#refs.texts + 1] = { Label = l, Full = mdToRich(seg.text) }
		elseif seg.type == "code" then
			local cc = makeCodeCard(parent, seg)
			cc.Frame.LayoutOrder = nextOrder()
			cc.Frame.Parent = parent
			seg.card = cc
			refs.codes[#refs.codes + 1] = cc
		end
	end
	return refs
end

local function typewriter(l, full, speed)
	speed = speed or 0.0016
	local n = #full
	local i = 0
	local step = math.max(1, math.floor(n / 1400))
	while i < n do
		i = math.min(n, i + step)
		l.Text = full:sub(1, i)
		task.wait(speed)
	end
	l.Text = full
end

function Chat.appendMessage(msg)
	local chat = Chat.current
	if not chat or not Chat.ui.bubbleHost then return end
	chat.messages[#chat.messages + 1] = msg
	chat.updated = os.time()
	if chat.title == "Nova conversa" and msg.role == "user" then
		chat.title = titleFrom(msg.text)
	end
	Config.save()

	local stick = isAtEnd(Chat.ui.scroll)
	local row, bubble, inner, meta = makeBubble(Chat.ui.bubbleHost, msg.role)

	local refs = renderSegments(msg, inner)
	msg.refs = refs
	if stick then task.defer(function() scrollToEnd(Chat.ui.scroll, true) end) end
	Chat.refreshSidebar()
	return refs
end

