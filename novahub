local saveTimer = nil
local function serializeMessage(m)
	local out = { role = m.role, text = "", segments = {} }
	for _, s in ipairs(m.segments or {}) do
		if s.type == "text" then
			out.segments[#out.segments + 1] = { type = "text", text = s.text }
			out.text = out.text .. s.text
		elseif s.type == "code" then
			out.segments[#out.segments + 1] = { type = "code", kind = s.kind, code = s.code }
			out.code = s.code
		end
	end
	return out
end

function Config.save()
	if not Compat.writeFile then return end
	if saveTimer then return end
	saveTimer = task.delay(1.2, function()
		saveTimer = nil
		local payload = {}
		for k, v in pairs(CONFIG) do
			if k ~= "chats" then payload[k] = U.copy(v) end
		end
		payload.chats = {}
		local total = 0
		for _, c in ipairs(CONFIG.chats) do
			total = total + 1
			if total > 30 then break end
			local cc = {
				id = c.id, title = c.title,
				created = c.created, updated = c.updated, messages = {},
			}
			local keep = 0
			for i = #c.messages, 1, -1 do
				keep = keep + 1
				if keep > 60 then break end
				table.insert(cc.messages, 1, serializeMessage(c.messages[i]))
			end
			payload.chats[#payload.chats + 1] = cc
		end
		local json = Json.encode(payload)
		if json then pcall(Compat.writeFile, CONFIG_PATH, json) end
	end)
end

function Config.load()
	if not Compat.readFile then return end
	local ok, raw = pcall(Compat.readFile, CONFIG_PATH)
	if not ok or type(raw) ~= "string" then return end
	local data = Json.decode(raw)
	if type(data) ~= "table" then return end
	for k, v in pairs(data) do
		if CONFIG[k] ~= nil then
			if type(CONFIG[k]) == "table" and type(v) == "table" then
				for k2, v2 in pairs(v) do CONFIG[k][k2] = v2 end
			else
				CONFIG[k] = v
			end
		end
	end

	-- normaliza conversas antigas (sem segments)
	for _, c in ipairs(CONFIG.chats or {}) do
		c.messages = c.messages or {}
		c.api = {}
		for _, m in ipairs(c.messages) do
			if type(m.segments) ~= "table" then
				local segs = {}
				if type(m.text) == "string" and m.text ~= "" then
					segs[#segs + 1] = { type = "text", text = m.text }
				end
				if type(m.code) == "string" and m.code ~= "" then
					segs[#segs + 1] = { type = "code", kind = "script", code = m.code }
				end
				m.segments = segs
			end
		end
	end
end

