		Visible = o.visible ~= false,
		ZIndex = o.z,
	}, parent)
	Round(f, o.radius or 9)
	local st = Stroke(f, Theme.v.border, 1)
	Watch(f, function() f.BackgroundColor3 = Theme.v.bg3 end)
	Watch(st, function() st.Color = Theme.v.border end)
	local label = Text(f, {
		text = o.placeholder or "selecionar", size = o.fontSize or 13,
		dim = UDim2.new(1, -46, 1, 0), pos = UDim2.fromOffset(12, 0),
		truncate = Enum.TextTruncate.AtEnd, role = "dim",
	})
	local chev = MakeIcon(nil, "chevronD", 14, Theme.v.mute)
	chev.Position = UDim2.new(1, -24, 0.5, -7)
	chev.Parent = f
	local hit = Create("TextButton", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = o.z }, f)

	local listFrame

	local function close()
		if listFrame then listFrame:Destroy() listFrame = nil end
	end

	local function open()
		if listFrame then return close() end
		local items = o.items and o.items() or {}
		if #items == 0 then
			Toast(o.emptyText or "Nada para listar", "warn")
			return
		end
		local listH = math.min(280, #items * 32 + 10)
		listFrame = Create("Frame", {
			BackgroundColor3 = Theme.v.bg2,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, listH),
			Position = UDim2.new(0, 0, 1, 4),
			ZIndex = 300,
		}, f)
		Round(listFrame, 10)
		Stroke(listFrame, Theme.v.bg4, 1)
		ListLayout(listFrame, 2, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
		Pad(listFrame, 4, 4, 4, 4)
		Watch(listFrame, function() listFrame.BackgroundColor3 = Theme.v.bg2 end)
		local below = f.AbsolutePosition.Y + f.AbsoluteSize.Y + 4 + listH < screenSize().Y - 20
		if not below then listFrame.Position = UDim2.new(0, 0, 0, -(listH + 4)) end
		for i, item in ipairs(items) do
			local text = type(item) == "table" and (item.label or item.value) or item
			local value = type(item) == "table" and item.value or item
			local row = Button(listFrame, {
				size = UDim2.new(1, -2, 0, 30), variant = "ghost", radius = 7,
				text = text, fontSize = o.fontSize or 13, textPad = 10, order = i,
			})
			row.Frame.BackgroundTransparency = 1
			row.Click(function()
				close()
				if o.onChange then o.onChange(value, item) end
			end)
		end
	end
	hit.Activated:Connect(open)

	local C = { Frame = f, Label = label }
	function C.Set(v2) label.Text = v2 end
	function C.SetColor(c) paintIcon(chev, c or Theme.v.mute) end
	function C.Open() open() end
	function C.Close() close() end
	function C.SetItems(fn2) o.items = fn2 end
	return C
end

