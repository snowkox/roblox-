function Providers.normalizeBase(p)
	local u = tostring(p.url or "")
	u = u:gsub("%s+", "")
	u = u:gsub("/+$", "")
	u = u:gsub("/chat/completions$", "")
	u = u:gsub("/completions$", "")
	u = u:gsub("/models$", "")
	u = u:gsub("/messages$", "")
	u = u:gsub("/tags$", "")
	return u
end

function Providers.isOllama(p)
	local u = string.lower(p.url or "")
	return (p.kind == "ollama") or u:find(":11434") ~= nil or u:find("ollama") ~= nil
end

function Providers.isAnthropic(p)
	local u = string.lower(p.url or "")
	return (p.kind == "anthropic") or u:find("anthropic") ~= nil
end

function Providers.chatEndpoint(p)
	local u = Providers.normalizeBase(p)
	if Providers.isOllama(p) then return u .. "/api/chat" end
	if Providers.isAnthropic(p) then return u .. "/messages" end
	return u .. "/chat/completions"
end

function Providers.modelsEndpoint(p)
	local u = Providers.normalizeBase(p)
	if Providers.isOllama(p) then return u .. "/api/tags" end
	return u .. "/models"
end

function Providers.headers(p)
	local h = { ["Content-Type"] = "application/json", ["Accept"] = "application/json" }
	local key = tostring(p.key or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if key ~= "" then
		if Providers.isAnthropic(p) then
			h["x-api-key"] = key
			h["anthropic-version"] = "2023-06-01"
		else
			h["Authorization"] = "Bearer " .. key
		end
	end
	return h
end

-- extrai lista de modelos de respostas variadas
function Providers.extractModels(data)
	local out = {}
	if type(data) ~= "table" then return out end
	local function push(v)
		if type(v) == "string" and v ~= "" then
			if not U.contains(out, v) then out[#out + 1] = v end
		elseif type(v) == "table" then
			local id = v.id or v.name or v.model or v.slug
			if type(id) == "string" and id ~= "" then
				if not U.contains(out, id) then out[#out + 1] = id end
			end
		end
	end
	local bucket = data.data or data.models or data.result or data.data_ or nil
	if type(bucket) == "table" then
		for _, v in ipairs(bucket) do push(v) end
	elseif type(bucket) == "string" then
		push(bucket)
	end
	if #out == 0 then
		for _, v in ipairs(data) do push(v) end
	end
	return out
end

function Providers.classify(p, modelId)
	local id = string.lower(modelId or "")
	if type(p.class) == "table" and p.class[modelId] then
		return p.class[modelId]
	end
	if p.allFree then return "free" end
	for _, hint in ipairs(FREE_HINTS) do
		if id:find(hint, 1, true) then return "free" end
	end
	return "paid"
end

function Providers.setClass(p, modelId, kind)
	p.class = p.class or {}
	if p.class[modelId] == kind then p.class[modelId] = nil
	else p.class[modelId] = kind end
	Config.save()
end

