local function slider(parent, value, min, max, onChange)
	local track = Create("Frame", {
		Size = UDim2.fromOffset(150, 6), BackgroundColor3 = Theme.v.bg4,
		BorderSizePixel = 0, Active = true,
	}, parent)
	Round(track, 3)
	Watch(track, function() track.BackgroundColor3 = Theme.v.bg4 end)
	local fill = Create("Frame", {
		Size = UDim2.fromOffset(75, 6), BackgroundColor3 = Theme.v.accent, BorderSizePixel = 0,
	}, track)
	Round(fill, 3)
	Watch(fill, function() fill.BackgroundColor3 = Theme.v.accent end)
	local knob = Create("Frame", {
		Size = UDim2.fromOffset(15, 15), BackgroundColor3 = Theme.v.text,
		AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0,
	}, track)
	Round(knob, 8)
	Watch(knob, function() knob.BackgroundColor3 = Theme.v.text end)

	local function paint(v)
		local pct = U.clamp((v - min) / (max - min), 0, 1)
		fill.Size = UDim2.fromOffset(math.max(1, 150 * pct), 6)
		knob.Position = UDim2.fromOffset(150 * pct, 3)
	end
	paint(value or 0.5)
	Dragify(track, function(x)
		local pct = U.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local v = min + (max - min) * pct
		paint(v)
		if onChange then onChange(v) end
	end)
	return { Set = paint, Frame = track }
end

