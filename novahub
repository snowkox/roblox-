function Providers.fetchModels(p, cb)
	local url = Providers.modelsEndpoint(p)
	local ok, body, code = Compat.http({ Url = url, Method = "GET", Headers = Providers.headers(p) })
	if not ok then
		cb(nil, "HTTP " .. tostring(code) .. ": " .. U.short(body, 140))
		return
	end
	local data = Json.decode(body)
	if not data then
		cb(nil, "Resposta nÃ£o Ã© JSON: " .. U.short(body, 140))
		return
	end
	local models = Providers.extractModels(data)
	if #models == 0 then
		cb(nil, "Resposta OK, mas nenhum modelo encontrado em /models")
		return
	end
	table.sort(models)
	cb(models, nil)
end

-- testa a API: /models + uma completion mÃ­nima
function Providers.test(p, cb)
	cb = cb or function() end
	cb({ stage = "start" })

	local url = Providers.modelsEndpoint(p)
	local chosen = p.testModel or (Providers.selectedModels(p)[1])
	local models, modelsErr

	local function step2()
		local payload = {
			model = chosen,
			messages = { { role = "user", content = "ping" } },
			max_tokens = 8,
			temperature = 0,
			stream = false,
		}
		if Providers.isOllama(p) then
			payload.stream = false
			payload.options = { num_predict = 8 }
		end
		local body = Json.encode(payload)
		local ok, res, code = Compat.http({
			Url = Providers.chatEndpoint(p),
			Method = "POST",
			Headers = Providers.headers(p),
			Body = body,
		})
		if not ok then
			local msg = "HTTP " .. tostring(code)
			local decoded = Json.decode(res or "")
			if type(decoded) == "table" then
				local errObj = decoded.error or decoded
				if type(errObj) == "table" then
					msg = msg .. " Â· " .. tostring(errObj.message or errObj.msg or (Json.encode(errObj) or ""):sub(1, 140))
				elseif type(errObj) == "string" then
					msg = msg .. " Â· " .. U.short(errObj, 140)
				end
			else
				msg = msg .. " Â· " .. U.short(res, 140)
			end
			cb({ stage = "done", ok = false, modelsErr = modelsErr, models = models, err = msg })
			return
		end
		cb({ stage = "done", ok = true, modelsErr = modelsErr, models = models, modelsCount = models and #models or 0 })
	end

	local ok, body, code = Compat.http({ Url = url, Method = "GET", Headers = Providers.headers(p) })
	if not ok then
		modelsErr = "/models â†’ HTTP " .. tostring(code) .. " Â· " .. U.short(body, 90)
		-- tenta mesmo assim com o modelo informado/digitado
		if not chosen then
			cb({ stage = "done", ok = false, modelsErr = modelsErr, models = nil,
				err = "NÃ£o foi possÃ­vel listar modelos. Confira a URL e a API key." })
			return
		end
		step2()
		return
	end

	local data = Json.decode(body)
	models = Providers.extractModels(data)
	if #models == 0 then
		modelsErr = "/models respondeu, mas veio vazio (normal em algumas APIs)"
	end
	chosen = chosen or models[1]
	p.testModel = chosen
	if not chosen then
		cb({ stage = "done", ok = false, modelsErr = modelsErr, models = models,
			err = "Nenhum modelo disponÃ­vel para testar. Digite um modelo no campo \"Modelos\"." })
		return
	end
	step2()
end

