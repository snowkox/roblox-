local function iconCanvas(size)
	local f = Create("Frame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
	})
	f.__shapes = {}
	return f
end

local function addShape(f, class, props)
	local o = Create(class, props)
	table.insert(f.__shapes, o)
	return o
end

local function rct(f, x, y, w, h, rot, radius)
	local o = addShape(f, "Frame", {
		Size = UDim2.fromOffset(math.max(1, math.round(w)), math.max(1, math.round(h))),
		Position = UDim2.fromOffset(math.round(x), math.round(y)),
		Rotation = rot or 0,
		BorderSizePixel = 0,
	})
	if radius then Round(o, radius) end
	return o
end

local function rc(f, cx, cy, w, h, rot, radius)
	return rct(f, cx - w / 2, cy - h / 2, w, h, rot, radius)
end

local function circ(f, cx, cy, d)
	return rc(f, cx, cy, d, d, 0, UDim.new(1, 0))
end

local function ring(f, cx, cy, d, thickness)
	local o = addShape(f, "Frame", {
		Size = UDim2.fromOffset(d, d),
		Position = UDim2.fromOffset(cx - d / 2, cy - d / 2),
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
	})
	Round(o, UDim.new(1, 0))
	local s = addShape(f, "UIStroke", {
		Color = Color3.fromRGB(255, 255, 255),
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	s.Parent = o
	return o, s
end

local function paintIcon(f, color)
	if not f then return end
	for _, o in ipairs(f.__shapes or {}) do
		if o:IsA("UIStroke") then o.Color = color else o.BackgroundColor3 = color end
	end
end

