-- busca uma funÃ§Ã£o global mesmo em ambientes com metatable
local function field(path)
	local cur = G
	for part in path:gmatch("[^%.]+") do
		if type(cur) ~= "table" and type(cur) ~= "userdata" then return nil end
		local v = rawget(cur, part)
		if v == nil then
			local ok, got = pcall(function() return cur[part] end)
			v = ok and got or nil
		end
		if v == nil then return nil end
		cur = v
	end
	if type(cur) == "function" then return cur end
	return nil
end

