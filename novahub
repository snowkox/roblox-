function Chat.setStatus(text)
	local ui = Chat.ui
	if not ui.status then return end
	if ui.dotsTask then
		pcall(task.cancel, ui.dotsTask)
		ui.dotsTask = nil
	end
	if not text then
		ui.status.Text = ""
		ui.status.Visible = false
		return
	end
	ui.status.Visible = true
	local frames = { "Â·  ", "Â· Â·  ", "Â· Â· Â·  " }
	local idx = 1
	ui.status.Text = text .. " " .. frames[1]
	ui.dotsTask = task.spawn(function()
		while ui.status and ui.status.Visible and Chat.busy do
			idx = idx % #frames + 1
			if ui.status then ui.status.Text = text .. " " .. frames[idx] end
			task.wait(0.32)
		end
	end)
end

