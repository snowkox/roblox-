local function ColorPicker(parent, hex, onChange, size)
	hex = hex or "#7c5cff"
	local cw = size or 250
	local sv = { h = 0, s = 0, v = 0 }
	local function hsvToColor(h, s, v)
		return Color3.fromHSV(((h % 360) + 360) % 360, U.clamp(s, 0, 1), U.clamp(v, 0, 1))
	end
	local function rgbToHsv(c)
		local h, s, v = Color3.toHSV(c)
		return (h or 0) * 360, s or 0, v or 0
	end
	local initial = U.fromHex(hex)
	sv.h, sv.s, sv.v = rgbToHsv(initial)

	local f = Create("Frame", { Size = UDim2.fromOffset(cw, 150), BackgroundTransparency = 1 }, parent)
	local svW, svH = cw, 96
	local svBox = Create("Frame", {
		BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, Active = true,
	}, f)
	svBox.Size = UDim2.fromOffset(svW, svH)
	Round(svBox, 10)
	local g1 = Create("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), hsvToColor(sv.h, 1, 1)),
	}, svBox)
	Create("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)),
		Transparency = NumberSequence.new({ Keypoint.new(0, 0), Keypoint.new(1, 1) }),
		Rotation = 90,
	}, svBox)
	local knob = Create("Frame", {
		Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0, ZIndex = 5, AnchorPoint = Vector2.new(0.5, 0.5),
	}, svBox)
	Round(knob, 7)
	local kStroke = Create("UIStroke", { Color = Color3.fromRGB(25, 25, 25), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, knob)

	local hueBar = Create("Frame", {
		Size = UDim2.fromOffset(svW, 14), Position = UDim2.fromOffset(0, svH + 12),
		BackgroundColor3 = Color3.fromRGB(255, 0, 0), BorderSizePixel = 0, Active = true,
	}, f)
	Round(hueBar, 7)
	Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
	}, hueBar)
	local hKnob = Create("Frame", {
		Size = UDim2.fromOffset(10, 18), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0, ZIndex = 5, AnchorPoint = Vector2.new(0.5, 0.5),
	}, hueBar)
	Round(hKnob, 5)
	Create("UIStroke", { Color = Color3.fromRGB(25, 25, 25), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, hKnob)

	local function emit()
		knob.Position = UDim2.fromOffset(sv.s * svW, (1 - sv.v) * svH)
		hKnob.Position = UDim2.fromOffset((sv.h / 360) * svW, 7)
		g1.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), hsvToColor(sv.h, 1, 1))
		if onChange then onChange(U.toHex(hsvToColor(sv.h, sv.s, sv.v))) end
	end

	Dragify(svBox, function(x, y)
		sv.s = U.clamp((x - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
		sv.v = U.clamp(1 - (y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
		emit()
	end)
	Dragify(hueBar, function(x)
		sv.h = U.clamp((x - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1) * 360
		emit()
	end)
	emit()

	local C = { Frame = f }
	function C.Set(newHex, silent)
		local c = U.fromHex(newHex)
		sv.h, sv.s, sv.v = rgbToHsv(c)
		knob.Position = UDim2.fromOffset(sv.s * svW, (1 - sv.v) * svH)
		hKnob.Position = UDim2.fromOffset((sv.h / 360) * svW, 7)
		g1.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), hsvToColor(sv.h, 1, 1))
		if not silent and onChange then onChange(newHex) end
	end
	return C
end

