function InputBox(parent, o)
	o = o or {}
	local h = o.h or 34
	local multiline = o.multiline == true
	local outerW = o.outerW or 24
	local f = Create("Frame", {
		Size = o.size or (o.w and UDim2.fromOffset(o.w, h) or UDim2.new(1, -outerW, 0, h)),
		BackgroundColor3 = Theme.v.bg3,
		BorderSizePixel = 0,
		Position = o.pos or UDim2.fromOffset(0, 0),
		LayoutOrder = o.order or 0,
		Visible = o.visible ~= false,
		ZIndex = o.z,
	}, parent)
	Round(f, o.radius or 9)
	local st = Stroke(f, Theme.v.border, 1)
	Watch(f, function() f.BackgroundColor3 = Theme.v.bg3 end)
	Watch(st, function() st.Color = Theme.v.bg4 end)
	if multiline then
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.Size = UDim2.new(1, -outerW, 0, h)
	end

	local px = o.icon and (o.iconGap or 32) or 12
	local iconHolder
	if o.icon then
		iconHolder = MakeIcon(nil, o.icon, 15, Theme.v.mute)
		iconHolder.Position = UDim2.fromOffset(o.iconGap or 34, multiline and (h / 2 - 8) or ((h - 15) / 2))
		iconHolder.Parent = f
	end

	local box = Create("TextBox", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -(px + 12), 1, multiline and -12 or -8),
		Position = UDim2.fromOffset(px, multiline and 6 or 4),
		Text = o.value or "",
		PlaceholderText = o.placeholder or "",
		PlaceholderColor3 = Theme.v.mute,
		TextColor3 = Theme.v.text,
		TextSize = o.fontSize or 14,
		TextXAlignment = o.alignX or Enum.TextXAlignment.Left,
		TextYAlignment = multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		Font = o.font or FONT,
		TextWrapped = multiline,
		ClearTextOnFocus = false,
		MultiLine = multiline,
		AutoLocalize = false,
		ZIndex = o.z,
	}, f)
	if o.password then
		box.Text = string.rep("*", #(o.value or ""))
	end
	Watch(box, function()
		box.TextColor3 = Theme.v.text
		box.PlaceholderColor3 = Theme.v.mute
		if iconHolder then paintIcon(iconHolder, Theme.v.mute) end
	end)

	local masked = o.password == true
	local real = o.value or ""
	local suppress = false
	local function refresh()
		suppress = true
		box.Text = masked and string.rep("*", #real) or real
		suppress = false
	end
	if o.password then refresh() end

	local C = { Frame = f, Box = box, Stroke = st, Icon = iconHolder }
	function C.Get() return real end
	function C.Set(v2)
		real = v2 or ""
		refresh()
		if o.onChange then o.onChange(real) end
	end
	function C.SetMasked(v2)
		masked = v2 == true
		refresh()
	end
	function C.IsMasked() return masked end
	function C.Placeholder(p2) box.PlaceholderText = p2 end
	function C.Clear()
		real = ""
		refresh()
	end
	function C.Focus() pcall(function() box:CaptureFocus() end) end
	function C.ReleaseFocus() pcall(function() box:ReleaseFocus() end) end
	function C.SetHeight(h2) f.Size = UDim2.new(1, -outerW, 0, h2) end
	function C.SetVisible(v2) f.Visible = v2 end
	function C.SetFont(fs) box.TextSize = fs end
	if o.onChange then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			if suppress then return end
			real = box.Text
			if masked then refresh() end
			o.onChange(real)
		end)
	end
	if o.onSubmit then
		local submit = o.onSubmit
		box.FocusLost:Connect(function(enter)
			if enter and box.Text ~= "" then submit(box.Text) end
		end)
	end
	return C
end

