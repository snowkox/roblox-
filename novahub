function AI.extractText(data)
	if type(data) ~= "table" then return nil end
	local function fromContent(c)
		if type(c) == "string" then return c end
		if type(c) == "table" then
			local parts = {}
			for _, p in ipairs(c) do
				if type(p) == "string" then parts[#parts + 1] = p
				elseif type(p) == "table" then
					parts[#parts + 1] = p.text or p.content or ""
				end
			end
			if #parts > 0 then return table.concat(parts, "\n") end
		end
		return nil
	end
	local choices = data.choices
	if type(choices) == "table" and choices[1] then
		local c = choices[1]
		if c.message then
			local t = fromContent(c.message.content)
			if t then return t end
			if type(c.message.reasoning) == "string" and #c.message.reasoning > 0 then
				return c.message.reasoning
			end
		end
		if type(c.text) == "string" then return c.text end
		if c.delta then
			local t = fromContent(c.delta.content)
			if t then return t end
		end
	end
	if type(data.content) == "table" then
		local t = fromContent(data.content)
		if t then return t end
	end
	if data.message and type(data.message.content) == "string" then return data.message.content end
	if type(data.response) == "string" then return data.response end
	if type(data.output_text) == "string" then return data.output_text end
	if type(data.text) == "string" then return data.text end
	return nil
end

