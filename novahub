-- BOTÃƒO ---------------------------------------------------------------------
function Button(parent, o)
	o = o or {}
	local variant = o.variant or "ghost"
	local h = o.h or 34
	local w = o.w
	local iconSize = o.iconSize or 16
	local iconPad = o.iconPad or 10

	local b = Create("TextButton", {
		AutoButtonColor = false,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Size = o.size or (w and UDim2.fromOffset(w, h) or UDim2.new(1, 0, 0, h)),
		Position = o.pos or UDim2.fromOffset(0, 0),
		AnchorPoint = o.anchor,
		Text = "",
		Font = FONT_SEMI,
		TextSize = o.fontSize or 13,
		LayoutOrder = o.order or 0,
		AutoLocalize = false,
		ZIndex = o.z,
		Visible = o.visible ~= false,
	}, parent)
	local corner = Round(b, o.radius or 9)
	local stroke = nil
	if variant == "outline" then
		stroke = Stroke(b, Theme.v.border, 1)
	end

	local state = { hover = false, pressed = false, on = false }

	local label, iconHolder, iconX = nil, nil, 0

	local function baseColors()
		local v = Theme.v
		if variant == "solid" then
			return v.accent, v.onAccent
		elseif variant == "soft" then
			return v.accent:Lerp(v.bg, 0.86), v.accent
		elseif variant == "danger" then
			return v.danger:Lerp(v.bg, 0.84), v.danger
		elseif variant == "outline" then
			return v.bg2, v.text
		end
		return v.bg, v.dim
	end

	local function repaint()
		local v = Theme.v
		local bg, fg = baseColors()
		if variant == "solid" then
			if state.pressed then bg = v.accentDown elseif state.hover then bg = v.accentHover end
		elseif variant == "soft" then
			if state.pressed then bg = v.accent:Lerp(v.bg, 0.7) elseif state.hover then bg = v.accent:Lerp(v.bg, 0.78) end
		elseif variant == "danger" then
			if state.pressed then bg = v.danger:Lerp(v.bg, 0.66) elseif state.hover then bg = v.danger:Lerp(v.bg, 0.76) end
		elseif variant == "outline" then
			if state.pressed then bg = v.bg4 elseif state.hover then bg = v.bg3 end
		else
			if state.pressed then bg = v.bg3 elseif state.hover then bg = v.bg3 else bg = v.bg end
		end
		b.BackgroundColor3 = bg
		b.BackgroundTransparency = 0
		if label then label.TextColor3 = fg end
		if iconHolder then paintIcon(iconHolder, fg) end
		if stroke then stroke.Color = state.hover and v.bg4 or v.border end
		if state.on then
			b.BackgroundColor3 = v.accent
			if label then label.TextColor3 = v.onAccent end
			if iconHolder then paintIcon(iconHolder, v.onAccent) end
			if stroke then stroke.Color = v.accent end
		end
	end
	Watch(b, repaint)

	if o.icon then
		iconHolder = MakeIcon(nil, o.icon, iconSize, Theme.v.dim)
		local textW = (o.text and #(o.text) * (o.fontSize or 13) * 0.56) or 0
		local total = iconSize + 6 + textW
		if w then
			iconX = math.max(8, (w - total) / 2)
		else
			iconX = iconPad
		end
		iconHolder.Position = UDim2.fromOffset(iconX, (h - iconSize) / 2)
		iconHolder.Parent = b
	end

	label = Text(b, {
		text = o.text or "",
		size = o.fontSize or 13,
		font = o.font or FONT_SEMI,
		truncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		dim = o.align == "center" and UDim2.new(1, -16, 1, 0)
			or (o.icon and UDim2.new(1, -(iconSize + iconPad + 8), 1, 0) or UDim2.new(1, -(iconPad * 2), 1, 0)),
		pos = o.align == "center" and UDim2.fromOffset(0, 0)
			or (o.icon and UDim2.fromOffset(iconX + iconSize + 6, 0) or UDim2.fromOffset(o.textPad or iconPad, 0)),
		alignX = o.align == "center" and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
	})
	repaint()

	local handlers = {}
	b.MouseEnter:Connect(function() state.hover = true repaint() end)
	b.MouseLeave:Connect(function() state.hover = false state.pressed = false repaint() end)
	b.MouseButton1Down:Connect(function() state.pressed = true repaint() end)
	b.MouseButton1Up:Connect(function() state.pressed = false repaint() end)
	b.Activated:Connect(function()
		if b.Active ~= false and b.Visible then
			for _, fn in ipairs(handlers) do pcall(fn) end
		end
	end)

	local C = {
		Frame = b, Label = label, Corner = corner, Stroke = stroke,
		Icon = iconHolder, On = false,
	}
	function C.SetText(t2)
		label.Text = t2
		repaint()
	end
	function C.Click(fn)
		table.insert(handlers, fn)
		return C
	end
	function C.SetEnabled(v2)
		b.Active = v2
		b.Selectable = v2
		label.TextTransparency = v2 and 0 or 0.5
	end
	function C.SetVisible(v2) b.Visible = v2 end
	function C.SetActiveState(v2) state.on = v2 C.On = v2 repaint() end
	function C.SetIcon(newName)
		if not iconHolder then
			iconHolder = MakeIcon(b, newName, iconSize, Theme.v.dim)
			iconHolder.Position = UDim2.fromOffset(iconX, (h - iconSize) / 2)
			if label then label.Position = UDim2.fromOffset(iconX + iconSize + 6, 0) end
		else
			local fresh = MakeIcon(nil, newName, iconSize, Theme.v.text)
			for _, sh in ipairs(fresh.__shapes) do
				sh.Parent = nil
				table.insert(iconHolder.__shapes, sh)
				sh.Parent = iconHolder
			end
		end
		repaint()
	end
	return C
end

function IconButton(parent, o)
	o = o or {}
	local size = o.size or 28
	local ic = math.round(o.iconSize or (type(size) == "number" and size * 0.6 or 16))
	local c
	if type(size) == "number" then
		c = Button(parent, {
			w = size, h = size, pos = o.pos, order = o.order,
			variant = o.variant or "ghost",
			radius = o.radius or 8,
			icon = o.icon,
			iconSize = ic,
			iconPad = 0,
			align = "center",
			text = "",
			z = o.z,
			visible = o.visible,
		})
		c.Icon.Position = UDim2.fromOffset((size - ic) / 2, (size - ic) / 2)
