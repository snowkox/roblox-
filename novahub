function Engine.makeTools(logFn)
	local tools = {}

	tools.info = function()
		return Engine.gameInfo()
	end

	tools.remotes = function(filter)
		return Engine.remotesText(filter)
	end

	tools.tree = function(path, depth)
		return Engine.treeText(path or "game", depth or 3)
	end

	tools.get = function(path)
		if type(path) ~= "string" then return nil end
		local ok, res = pcall(function()
			if path:sub(1, 5) == "game." then return game:GetService(path:sub(6)) end
			return game:GetService(path)
		end)
		if ok then return res end
		return nil
	end

	tools.find = function(name, className)
		local results = {}
		for _, r in ipairs(Engine.scanRemotes({ includeBindables = true })) do
			if (not name or string.lower(r.name) == string.lower(name))
				and (not className or r.class == className) then
				results[#results + 1] = r
			end
		end
		return results
	end

	tools.fire = function(target, ...)
		local args = { ... }
		if #args == 1 and type(args[1]) == "table" and not args[1].IsA then args = args[1] end
		local sent = 0
		local details = {}
		local list
		if type(target) == "string" then
			list = {}
			for _, r in ipairs(Engine.scanRemotes({ includeBindables = false })) do
				if string.lower(r.name) == string.lower(target)
					or string.lower(r.path) == string.lower(target) then
					list[#list + 1] = r
				end
			end
		elseif type(target) == "table" and target.instance then
			list = { target }
		end
		for _, r in ipairs(list or {}) do
			if r.instance and r.instance:IsA("RemoteEvent") then
				local ok, err = pcall(function() r.instance:FireServer(unpack(args)) end)
				sent = sent + (ok and 1 or 0)
				details[#details + 1] = (ok and "ok: " or "erro: ") .. r.path
			end
		end
		if #details == 0 then return "nenhum RemoteEvent corresponde a " .. tostring(target) end
		return "disparados " .. sent .. " remote(s): " .. table.concat(details, ", ")
	end

	tools.fireAll = function(argsTable)
		local args = type(argsTable) == "table" and argsTable or {}
		local sent, list = 0, {}
		for _, r in ipairs(Engine.scanRemotes({ includeBindables = false })) do
			if r.instance and r.instance:IsA("RemoteEvent") then
				local ok = pcall(function() r.instance:FireServer(unpack(args)) end)
				if ok then sent = sent + 1 end
				list[#list + 1] = r.name
			end
		end
		return "disparados " .. sent .. " remotes: " .. table.concat(list, ", ")
	end

	tools.call = function(target, argsTable)
		local args = type(argsTable) == "table" and argsTable or {}
		local targetInst
		if type(target) == "string" then
			for _, r in ipairs(Engine.scanRemotes({ includeBindables = false })) do
				if r.instance:IsA("RemoteFunction")
					and (string.lower(r.name) == string.lower(target) or string.lower(r.path) == string.lower(target)) then
					targetInst = r.instance
					break
				end
			end
		elseif type(target) == "Instance" then
			targetInst = target
		end
		if not targetInst then return "RemoteFunction nÃ£o encontrado" end
		local ok, res = pcall(function() return targetInst:InvokeServer(unpack(args)) end)
		if not ok then return "erro: " .. tostring(res) end
		if type(res) == "table" then
			local enc = Json.encode(res)
			return enc or tostring(res)
		end
		return tostring(res)
	end

	tools.log = function(...)
		logFn(table.concat({ ... }, " "))
	end

	tools.http = function(url, opts)
		opts = opts or {}
		local ok, body, code = Compat.http({
			Url = url,
			Method = opts.method or "GET",
			Headers = opts.headers,
			Body = opts.body,
		})
		return (ok and "HTTP " .. tostring(code) .. "\n" or "HTTP " .. tostring(code) .. " (erro)\n") .. tostring(body or "")
	end

	tools.game = game
	tools.workspace = workspace
	tools.player = LocalPlayer
	tools.services = game:GetService
	tools.players = game:GetService("Players")
	tools.hub = CONFIG.ai
	return tools
end

function Engine.exec(code, opts)
	opts = opts or {}
	local logs = {}
	local started = os.clock()

	local function log(str)
		logs[#logs + 1] = tostring(str)
		if opts.onLog then opts.onLog(tostring(str)) end
	end

	local tools = Engine.makeTools(log)
	local baseEnv = G
	local env = setmetatable({ nova = tools, hub = tools }, { __index = baseEnv })

	-- captura print/warn (no env e no ambiente global)
	local function capture(...)
		local parts = {}
		for i = 1, select("#", ...) do
			local v = select(i, ...)
			parts[#parts + 1] = (type(v) == "string") and v or (v == nil and "nil" or tostring(v))
		end
		log(table.concat(parts, " "))
	end

	local gPrint, gWarn
	env.print = capture
	env.warn = capture
	if type(baseEnv) == "table" then
		gPrint, gWarn = baseEnv.print, baseEnv.warn
		pcall(function() baseEnv.print = capture end)
		pcall(function() baseEnv.warn = capture end)
	end

	local function restore()
		if type(baseEnv) == "table" then
			pcall(function() baseEnv.print = gPrint end)
			pcall(function() baseEnv.warn = gWarn end)
		end
	end

	local result = { ok = false, logs = logs, err = "", code = code }

	local okLoad, fn, lerr = pcall(Compat.load, code, "nova_chunk", env)
	if not okLoad or type(fn) ~= "function" then
		restore()
		result.err = "nÃ£o foi possÃ­vel compilar: " .. tostring(lerr or fn or "loadstring indisponÃ­vel")
		if opts.onLog then opts.onLog(result.err) end
		return result
	end

	local co = coroutine.create(fn)
	local okRun, err = coroutine.resume(co)
	restore()

	if not okRun then
		result.err = tostring(err):gsub("nova_chunk", "cÃ³digo")
	end
	result.ok = (okRun == true)
	result.time = os.clock() - started
	local stamp = "(" .. string.format("%.0f ms", (result.time or 0) * 1000) .. ")"
	logs[#logs + 1] = stamp
	if opts.onLog then opts.onLog(stamp) end
	return result
end

